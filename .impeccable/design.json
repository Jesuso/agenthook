      "html": "<nav class=\"ds-nav\"><a class=\"ds-tab ds-tab-active\" href=\"#\">Overview</a><a class=\"ds-tab\" href=\"#\">Stats</a><a class=\"ds-tab\" href=\"#\">Epics</a><a class=\"ds-tab\" href=\"#\">Config</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;background:var(--color-surface,#12161b);padding:6px;border-bottom:1px solid var(--color-border,#2a313a)}.ds-tab{color:var(--color-muted,#9ba4b4);text-decoration:none;border-radius:5px;padding:4px 12px;font:500 12px/16px ui-sans-serif,system-ui,sans-serif}.ds-tab:hover{background:var(--color-surface-raised,#1a2027);color:var(--color-fg,#e6e9ef)}.ds-tab-active{background:var(--color-surface-raised,#1a2027);color:var(--color-fg,#e6e9ef)}.ds-tab:focus-visible{outline:2px solid var(--color-accent,#5b9bff)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
