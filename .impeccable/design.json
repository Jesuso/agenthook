      "html": "<button class=\"ds-btn-primary\">Send answer</button>",
      "css": ".ds-btn-primary{background:var(--color-accent,#5b9bff);color:var(--color-accent-fg,#0b0d10);border:0;border-radius:5px;padding:4px 12px;font:500 12px/16px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-accent,#5b9bff);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5}"
    },
