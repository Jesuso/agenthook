      "description": "Dot plus state word in its status hue; colour means state only.",
      "html": "<span class=\"ds-badge ds-held\"><i></i>held</span> <span class=\"ds-badge ds-failed\"><i></i>failed</span> <span class=\"ds-badge ds-running\"><i></i>running</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;border-radius:3px;padding:0 6px;font:500 12px/16px ui-sans-serif,system-ui,sans-serif}.ds-badge i{width:6px;height:6px;border-radius:50%;background:currentColor}.ds-held{color:var(--color-status-held,#e3b341);background:var(--color-status-held-bg,#2e2410)}.ds-failed{color:var(--color-status-failed,#ff7b72);background:var(--color-status-failed-bg,#351616)}.ds-running{color:var(--color-status-running,#6cb0ff);background:var(--color-status-running-bg,#10243d)}"
