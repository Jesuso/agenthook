      "css": ".ds-btn-secondary{background:transparent;color:var(--color-fg,#e6e9ef);border:1px solid var(--color-border,#2a313a);border-radius:5px;padding:2px 8px;font:500 12px/16px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{background:var(--color-surface-raised,#1a2027)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-accent,#5b9bff)}"
