{
  "name": "@jesuso/agenthook",
  "version": "0.3.0",
  "description": "Event-driven agentic development. Webhook in, coding agent out. No polling loops.",
  "type": "module",
  "bin": {
    "agenthook": "bin/agenthook.js"
  },
  "files": [
    "bin",
    "src",
    "ui/dist",
    "SECURITY.md",
    "INSTRUCTIONS.example.md",
    "agenthook.config.example.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "agenthook": "node bin/agenthook.js",
    "build:ui": "vite build ui",
    "typecheck:ui": "tsc -p ui --noEmit",
    "test:ui": "vitest run --root ui",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:ui"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent",
    "agents",
    "ai",
    "claude",
    "webhook",
    "automation",
    "devtools",
    "pipeline",
    "kanban",
    "coding-agent",
    "asana",
    "jira"
  ],
  "author": "Ignacio Ortiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jesuso/agenthook.git"
  },
  "homepage": "https://github.com/Jesuso/agenthook#readme",
  "bugs": {
    "url": "https://github.com/Jesuso/agenthook/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
